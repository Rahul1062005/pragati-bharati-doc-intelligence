# ==========================================
# Pragati Bharati - Document Intelligence & Question Extraction
# Environment Configuration
# ==========================================

# Application
APP_NAME="Document Intelligence & Question Extraction Service"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security / JWT
# Generate secret key in production: openssl rand -hex 32
SECRET_KEY=super-secret-key-for-pragati-bharati-production-assignment-change-in-prod-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default SQLite for local standalone development.
# For PostgreSQL in Docker or Cloud:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/doc_intelligence
DATABASE_URL=sqlite:///./doc_intelligence.db

# Redis / Queue
# If empty or unreachable, the system automatically falls back to asynchronous BackgroundTasks / thread pool
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=./storage_uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# External AI / LLM Configuration (Optional)
# If provided, enables multi-modal AI Vision extraction for complex/messy scans.
# If left empty, the engine uses the built-in heuristic/PyMuPDF parser seamlessly.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=none
